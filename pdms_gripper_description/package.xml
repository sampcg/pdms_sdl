<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>pdms_gripper_description</name>
  <version>0.1.0</version>
  <description>
    Custom fork-finger end effector for the myCobot 320 adaptive gripper.
    Replaces the stock gripper_left1 / gripper_right1 finger blades with flat
    clamping forks, as an overlay on the upstream mycobot_description package.
  </description>
  <maintainer email="2002grays@gmail.com">samuel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mycobot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
