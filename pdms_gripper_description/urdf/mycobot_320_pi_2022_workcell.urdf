  </joint>

  <link name="pipette_socket"/>

  <joint name="holder_to_socket" type="fixed">
    <parent link="pipette_holder"/>
    <child link="pipette_socket"/>
    <origin xyz="0.00000 0.03500 0.00000" rpy="0.00000 0.00000 0.00000"/>
