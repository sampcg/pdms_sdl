      <origin xyz="0.00000 0.00000 0.00000" rpy="0.00000 0.00000 0.00000"/>
    </collision>
  </link>

  <joint name="world_to_frame" type="fixed">
    <parent link="world"/>
    <child link="frame"/>
    <origin xyz="0.26972 -0.34913 0.00000" rpy="0.00000 0.00000 -1.57080"/>
  </joint>

  <link name="pipette_holder">
